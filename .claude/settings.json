{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune -a*)",
      "Bash(docker image prune --all*)",
      "Bash(docker builder prune*)",
      "Bash(taskkill /IM*)",
      "Bash(taskkill //IM*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "PowerShell(Stop-Process -Name*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)"
    ]
  },
  "env": {
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1"
  }
}
