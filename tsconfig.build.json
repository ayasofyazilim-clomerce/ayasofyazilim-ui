{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/aria",
    "src/components",
    "src/custom",
    "src/hooks",
    "src/lib"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__",
    "src/**/demo.tsx"
  ]
}
